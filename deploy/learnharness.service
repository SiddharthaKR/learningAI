# Template: replace <USER> before installing to /etc/systemd/system/learnharness.service
[Unit]
Description=LearnHarness Office
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/app
EnvironmentFile=/home/<USER>/app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start
# Manual start only (owner, 2026-11-11): no Restart= (a crash stays down) and no
# [Install] section (it can never be enabled to start at boot). Start with deploy/start.sh.

# Copy to .env and replace placeholders with internal values only.
# LLM (LM Studio via the Gemma 4 proxy on the host)
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=model-id
LLM_TOOL_MODE=native
LLM_CONTEXT_WINDOW=replace-with-model-context-window
LLM_MAX_TOKENS=replace-with-model-max-output-tokens
LLM_VISION=true-or-false
LLM_REASONING=true-or-false
LLM_API_KEY=
EMBEDDING_MODEL=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# Admin: the account with exactly this username is the admin (/admin, /admin/knowledge,
# shared-knowledge activity log). Empty = no admin. Sign up this username yourself first.
LH_ADMIN_USERNAME=
# Optional admin-built shared index (npm run index:shared). Uploads to the Shared
# pool from the Knowledge page work without these; set both to add a folder index.
KNOWLEDGE_SHARED_DIR=
KNOWLEDGE_INDEX_FILE=
MAX_CONCURRENT_LLM=4
NEXT_TELEMETRY_DISABLED=1
# Web search: SearXNG on this host, called directly (not via proxy).
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8080
# Corporate proxy (used by web_fetch only). Set on the host; never commit credentials.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host

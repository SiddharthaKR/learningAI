# Copy to .env and replace placeholders with internal values only.
LLM_BASE_URL=http://host:port/v1
LLM_MODEL=model-id
LLM_TOOL_MODE=native
LLM_CONTEXT_WINDOW=replace-with-model-context-window
LLM_MAX_TOKENS=replace-with-model-max-output-tokens
LLM_VISION=true-or-false
LLM_REASONING=true-or-false
LLM_API_KEY=
EMBEDDING_MODEL=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
KNOWLEDGE_SHARED_DIR=/srv/office-knowledge
KNOWLEDGE_INDEX_FILE=/srv/office-index/knowledge.json
MAX_CONCURRENT_LLM=4
NEXT_TELEMETRY_DISABLED=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host
